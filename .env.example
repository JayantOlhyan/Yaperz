# ==============================================================================
# YAPERZ STOREFRONT & COMMERCE BACKEND — ENVIRONMENT VARIABLE BASELINE
# ==============================================================================
# IMPORTANT: This file contains configuration placeholders ONLY.
# NEVER commit real credentials, production secrets, or private keys to source control.
# Copy this file to .env.local for local development.
# ==============================================================================

# Core Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Persistence (PostgreSQL / Supabase / Prisma)
DATABASE_URL=
DIRECT_URL=

# Authentication & Session Security (NextAuth.js / Auth.js)
AUTH_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Payment Gateway (Razorpay India)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Logistics & Order Fulfillment (Shiprocket API)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CLIENT_ID=
SHIPROCKET_CLIENT_SECRET=
SHIPROCKET_WEBHOOK_SECRET=

# Transactional Email (Resend / SendGrid / Postmark)
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=

# WhatsApp Business Cloud API (Order Updates & OTPs)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Media & Storage (AWS S3 / Cloudflare R2 / Uploadcare)
STORAGE_PROVIDER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Client Telemetry & Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Cryptographic Keys & Internal Cron Jobs
ENCRYPTION_KEY=
CRON_SECRET=
